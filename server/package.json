{
  "name": "top-rated-hotels-api",
  "version": "1.0.0",
  "private": true,
  "description": "Top Rated Hotels API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
